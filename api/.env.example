# Copier en .env sur le serveur. JAMAIS dans le dépôt.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Passer à true après un essai réel réussi avec le fournisseur.
IA_ACTIVE=false
FOURNISSEUR_IMAGE=openai
MODELE_OPENAI_IMAGE=gpt-image-2.5-sunburst
MODELE_OPENAI_ANALYSE=gpt-5.4-mini
HF_KEY=
# Ouvrir seulement après une génération Higgsfield réelle réussie et contrôlée.
VIDEO_ACTIVE=false
# Garder Seedance pour les clients tant que la recette visuelle Kling n'est pas validée.
# Autre modèle pris en charge : kling-video/v3.0/pro/image-to-video
VIDEO_MODELE=bytedance/seedance-2.5/image-to-video
DATABASE_URL=sqlite:///./studio.db
# Stockage des photos, compatible S3. Amazon : remplir AWS_REGION. Cloudflare R2 : remplir R2_ACCOUNT_ID.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=studio-annonce
S3_PUBLIC_URL=
AWS_REGION=
R2_ACCOUNT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SECRET_KEY=changer-moi
URL_PUBLIQUE_API=http://localhost:8000
CODE_DANS_LA_REPONSE=false

# Paiement : ouvrir seulement après test Stripe, validation des prix et disponibilité IA.
PAIEMENT_ACTIF=false
URL_PUBLIQUE_SITE=https://studioannonce.fr

# Règles communes au site et au mobile (29 septembre 2026).
ESSAIS_MAX_PAR_PHOTO=2
ESSAIS_MAX_PHOTO_OFFERTE=2
ESSAIS_PAR_CORRECTION_PAYANTE=1
CREATIONS_PHOTO_SANS_ACHAT=30
CREATIONS_VIDEO_SANS_ACHAT=10
SUPPORT_TELEPHONE=06 34 97 26 93
SUPPORT_URL=https://wa.me/33634972693
SUPPORT_EMAIL=contact@studioannonce.fr
