# Copier en .env à côté de docker-compose.yml. JAMAIS dans le dépôt.
DOMAINE=studio.exemple.fr            # le nom de domaine qui pointe vers ce serveur (A / AAAA)
POSTGRES_PASSWORD=                    # un mot de passe long, tiré au sort
SECRET_KEY=                           # idem, autre valeur

OPENAI_API_KEY=                       # génération des images (GPT Image)
GEMINI_API_KEY=                       # analyse des photos
FOURNISSEUR_IMAGE=openai

# Photos chez Amazon S3 (recommandé). Laisser vide = disque du serveur.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=studio-annonce
AWS_REGION=eu-west-3
S3_PUBLIC_URL=                        # facultatif : adresse CloudFront devant le bucket

# Mails de connexion. Vides = le code s'affiche à l'écran (CODE_DANS_LA_REPONSE) : démo seulement.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
CODE_DANS_LA_REPONSE=true

# Paiement (plus tard)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
